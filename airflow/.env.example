# ---------------------------------------------------------------------------
# Template for airflow/.env
#
#   cp airflow/.env.example airflow/.env
#
# Airflow-specific configuration. Everything this component needs lives here,
# including its internal PostgreSQL metadata database.
#
# Never commit airflow/.env. Keep this template up to date instead.
# ---------------------------------------------------------------------------

# Airflow image / user
_AIRFLOW_VERSION=3.1.0
AIRFLOW_UID=1000
AIRFLOW_GID=0

# Admin account created by airflow-init
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change-me

# Extra Python packages installed at container start (quick checks only;
# prefer adding them to requirements.txt and rebuilding the image).
_PIP_ADDITIONAL_REQUIREMENTS=

# JWT signing key for the Airflow API server. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_API_AUTH_JWT_SECRET=change-me

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=5050

# PostgreSQL - Airflow metadata database (internal to this component).
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=airflow
