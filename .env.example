# ---------------------------------------------------------------------------
# Template for the project-level .env file.
#
#   cp .env.example .env
#
# Shared project settings only. Anything belonging to a single component goes
# in docker/<component>/.env.example (e.g. docker/airflow/.env.example), including that
# component's own databases.
# ---------------------------------------------------------------------------

# Stable Compose project name (prefixes volumes and networks).
COMPOSE_PROJECT_NAME=ot7-projet
