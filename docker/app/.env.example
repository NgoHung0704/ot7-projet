# ---------------------------------------------------------------------------
# Template for app/.env
#
#   cp docker/app/.env.example docker/app/.env
#
# The Impact Duel game. It logs in as game_reader with GAME_READER_PASSWORD from the root .env.
#
# Never commit docker/app/.env. Keep this template up to date instead.
# ---------------------------------------------------------------------------

# Warehouse database name: POSTGRES_DB in docker/postgres/.env
GAME_DB_NAME=warehouse

# Port of the game on this machine: http://localhost:8501
GAME_APP_PORT=8501
